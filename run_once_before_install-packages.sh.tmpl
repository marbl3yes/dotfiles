#!/bin/bash
set -euo pipefail

case "{{ .chezmoi.os }}" in
  darwin)
    brew install fzf fd bat eza zoxide starship lazygit neovim fnm ripgrep git-delta
    brew install zsh-autosuggestions zsh-completions zsh-syntax-highlighting
    brew install --cask ghostty
    ;;
  linux)
    sudo apt update
    sudo apt install -y zsh fzf fd-find bat eza zoxide starship lazygit ripgrep git-delta
    sudo chsh -s "$(command -v zsh)" "$USER"

    # Ubuntu names the binaries fd/fdfind and bat/batcat — provide the expected names
    mkdir -p "$HOME/.local/bin"
    ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
    ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"

    # fnm is not packaged in Ubuntu — install the official script
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell

    # Neovim: apt's version is too old for LazyVim, install the official release
    case "$(uname -m)" in
      x86_64)  nvim_url="https://github.com/neovim/neovim/releases/download/stable/nvim-linux-x86_64.tar.gz" ;;
      aarch64) nvim_url="https://github.com/neovim/neovim/releases/download/stable/nvim-linux-aarch64.tar.gz" ;;
    esac
    curl -fsSL "$nvim_url" -o /tmp/nvim.tar.gz
    nvim_dir="$(tar tzf /tmp/nvim.tar.gz | sed -n '1s#/.*##p')"
    sudo tar xf /tmp/nvim.tar.gz -C /opt
    sudo ln -sf "/opt/$nvim_dir/bin/nvim" /usr/local/bin/nvim

    # Oh-my-zsh + the plugins referenced by .zshrc
    if [ ! -d "$HOME/.oh-my-zsh" ]; then
      sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
      git clone https://github.com/zsh-users/zsh-autosuggestions "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
      git clone https://github.com/zsh-users/zsh-completions "$HOME/.oh-my-zsh/custom/plugins/zsh-completions"
      git clone https://github.com/zsh-users/zsh-syntax-highlighting "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"
      git clone https://github.com/Aloxaf/fzf-tab "$HOME/.oh-my-zsh/custom/plugins/fzf-tab"
      git clone https://github.com/zsh-users/zsh-history-substring-search "$HOME/.oh-my-zsh/custom/plugins/zsh-history-substring-search"
    fi
{{ if ne .role "server" }}
    # Ubuntu 26.04+ packages Ghostty; older releases need a separate installer.
    if apt-cache show ghostty >/dev/null 2>&1; then
      sudo apt install -y ghostty
    else
      printf 'Ghostty is unavailable in this Ubuntu repository. See https://ghostty.org/docs/install/binary\n'
    fi
{{ end }}
    ;;
esac

# Herdr is optional. Ask only when it is missing and a terminal is available.
if ! command -v herdr >/dev/null 2>&1; then
  if [ -t 0 ] || [ -t 1 ]; then
    printf 'Install Herdr? [y/N] ' >/dev/tty
    IFS= read -r install_herdr </dev/tty || install_herdr=''
    case "$install_herdr" in
      y|Y|yes|YES)
        case "{{ .chezmoi.os }}" in
          darwin) brew install herdr ;;
          linux) curl -fsSL https://herdr.dev/install.sh | sh ;;
        esac
        ;;
    esac
  else
    printf 'Herdr was not installed. Install later from https://herdr.dev/docs/install/\n'
  fi
fi
